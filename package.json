{
  "name": "accordion-js",
  "version": "3.4.1",
  "license": "MIT",
  "author": "Michał Strumpf",
  "type": "module",
  "description": "Lightweight and accessible accordion module for JavaScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michu2k/Accordion.git"
  },
  "keywords": [
    "javascript",
    "accordion",
    "a11y",
    "es6",
    "accessibility",
    "aria",
    "javascript-library"
  ],
  "homepage": "https://github.com/michu2k/Accordion#readme",
  "bugs": {
    "url": "https://github.com/michu2k/Accordion/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./accordion.min.css": "./dist/accordion.min.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start:dev": "tsdown --watch ./src/**/*",
    "build": "tsdown",
    "ts:check": "tsc --noEmit",
    "lint:check": "eslint \"**/*.{js,ts,mjs,mts}\"",
    "lint:fix": "eslint \"**/*.{js,ts,mjs,mts}\" --fix",
    "format:check": "prettier \"**/*.{js,ts,mjs,mts}\" --check --cache",
    "format:fix": "prettier \"**/*.{js,ts,mjs,mts}\" --write --cache",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@tsdown/css": "^0.23.2",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}