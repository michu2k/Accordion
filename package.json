{
  "name": "accordion-js",
  "version": "3.4.1",
  "license": "MIT",
  "author": "Michał Strumpf",
  "type": "module",
  "description": "Lightweight and accessible accordion module for JavaScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michu2k/Accordion.git"
  },
  "keywords": [
    "javascript",
    "accordion",
    "a11y",
    "es6",
    "accessibility",
    "aria",
    "javascript-library"
  ],
  "homepage": "https://github.com/michu2k/Accordion#readme",
  "bugs": {
    "url": "https://github.com/michu2k/Accordion/issues"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start:dev": "tsdown --watch ./src/**/*",
    "build": "tsdown",
    "ts:check": "tsc --noEmit",
    "lint:check": "eslint \"**/*.{js,ts,mjs,mts}\"",
    "lint:fix": "eslint \"**/*.{js,ts,mjs,mts}\" --fix",
    "format:check": "prettier \"**/*.{js,ts,mjs,mts}\" --check --cache",
    "format:fix": "prettier \"**/*.{js,ts,mjs,mts}\" --write --cache",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@tsdown/css": "^0.22.0",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "^9.17.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.8"
  },
  "browserslist": [
    ">0.15%",
    "not dead",
    "Chrome >= 80",
    "Edge >= 80",
    "Firefox >= 74",
    "Opera >= 68",
    "Safari >= 13",
    "not op_mini all",
    "not IE 11"
  ]
}
